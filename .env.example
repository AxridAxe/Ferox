# Upstream provider credentials
OPENROUTER_API_KEY=

# Comma-separated list of API keys clients must send as `x-api-key`
# to use this gateway. Generate long random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FEROX_API_KEYS=

# Comma-separated list of origins allowed to call this gateway from a browser
ALLOWED_ORIGINS=http://localhost:3000

# Port the gateway listens on
PORT=8787
